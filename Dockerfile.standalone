# syntax=docker/dockerfile:1
FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY sdk ./sdk
COPY wit ./wit
RUN cargo build --locked --release -p wasmplane-wasip3-host --bin wasmplane

# A stateless deployment sample. Replace service.wasm and app.json in a derived image
# to deploy another Rust, MoonBit, or WAT/Wasm Component Model application.
FROM build AS sample
COPY infra/aws-image/service ./infra/aws-image/service
RUN rustup target add wasm32-wasip2 \
  && cargo build --locked --release --manifest-path infra/aws-image/service/Cargo.toml --target wasm32-wasip2

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libssl3 \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/wasmplane /usr/local/bin/wasmplane
WORKDIR /app
COPY --from=sample /src/infra/aws-image/service/target/wasm32-wasip2/release/wasmplane_deployment_sample.wasm /app/service.wasm
COPY infra/aws-image/app.json /app/app.json
USER 65532:65532
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/wasmplane"]
CMD ["start", "/app/app.json"]
