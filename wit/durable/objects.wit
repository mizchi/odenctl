package wasmplane:durable@0.1.0;

/// Access celld actors through bindings granted by the host.
/// Gateway endpoints, namespaces and credentials stay on the host.
interface objects {
  record request {
    method: string,
    path: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
    /// Forwarded as x-wasmplane-request-id. Deduplication is actor-defined;
    /// the adapter never retries a request automatically.
    request-id: option<string>,
  }
  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  variant error {
    binding-denied,
    invalid-request(string),
    unavailable,
    deadline-exceeded,
    /// Dispatch began, but no valid response was received. The actor may
    /// already have committed its update, including after cancellation.
    outcome-unknown,
  }
  /// A handle scoped to this guest execution. Dropping it releases the handle,
  /// not the actor or its persistent storage.
  resource object {
    /// HTTP actor status codes are returned in response, not as adapter errors.
    fetch: async func(req: request) -> result<response, error>;
  }
  /// Resolve a granted binding and stable object name. This does not contact
  /// celld; fetch performs the remote call.
  open: func(binding: string, name: string) -> result<object, error>;
}

world client {
  import objects;
}
