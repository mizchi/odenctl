# Interactive API reference for the setup in docs/user/control-plane.md.
# Run `just rust-build guest-build` first. Replace componentBase64 with the base64
# bytes of examples/hello-worker/target/wasm32-wasip2/debug/hello_worker.wasm.
# The odenctl deploy CLI performs upload/deployment/route/publication automatically.
# After uploading, set artifactId below to the returned id before creating the
# deployment. Identical bytes in the same project reuse the existing artifact,
# whose id can differ from the requested art_hello.
@control = http://127.0.0.1:8787
@runtime = http://127.0.0.1:8788
@controlToken = local-control-token
@projectId = prj_hello
@artifactId = art_hello
@deploymentId = dep_hello
@componentBase64 = REPLACE_WITH_BASE64_OF_BUILT_COMPONENT

### Create a project (skip if it already exists)
POST {{control}}/projects
authorization: Bearer {{controlToken}}
content-type: application/json

{"id":"{{projectId}}","name":"Hello"}

### Upload a real WASI HTTP component; the host validates the bytes
POST {{control}}/artifacts/local
authorization: Bearer {{controlToken}}
content-type: application/json

{
  "id": "{{artifactId}}",
  "projectId": "{{projectId}}",
  "bytesBase64": "{{componentBase64}}"
}

### Create an immutable standard HTTP deployment
# First update @artifactId above to the id from the upload response.
POST {{control}}/deployments
authorization: Bearer {{controlToken}}
content-type: application/json

{
  "id": "{{deploymentId}}",
  "projectId": "{{projectId}}",
  "artifactId": "{{artifactId}}",
  "world": "wasi:http/service@0.3.0",
  "worldVersion": "0.3.0",
  "runtime": { "backend": "wasmtime", "version": "wasmtime-48.0.2", "wasi": "wasip3" },
  "limits": {
    "cpuMs": 5000,
    "memoryMb": 64,
    "wallMs": 10000,
    "requestBytes": 1048576,
    "subrequests": 20,
    "responseBytes": 1048576
  },
  "capabilities": {
    "outboundHttp": { "enabled": false, "allow": [] },
    "kv": [], "secrets": [], "durableObjects": [], "services": [],
    "arbitraryFilesystem": false, "arbitrarySockets": false, "processSpawn": false
  }
}

### Point the route at the deployment
PUT {{control}}/routes
authorization: Bearer {{controlToken}}
content-type: application/json

{
  "projectId": "{{projectId}}",
  "host": "hello.example.dev",
  "pathPrefix": "/",
  "deploymentId": "{{deploymentId}}"
}

### Publish to the static or registered runtime targets; inspect ok and targets
POST {{control}}/snapshots/routes/publish
authorization: Bearer {{controlToken}}

### Read publication history
GET {{control}}/snapshots/routes/publishes
authorization: Bearer {{controlToken}}

### Request the deployed guest without configuring DNS
GET {{runtime}}/
Host: hello.example.dev

### Roll back by selecting an earlier deployment ID, then publish again
# POST {{control}}/routes/rollback
# authorization: Bearer {{controlToken}}
# content-type: application/json
#
# {"projectId":"{{projectId}}","host":"hello.example.dev","pathPrefix":"/","deploymentId":"dep_previous"}
#
# Resource records for KV/secrets/DOs are documented in the control-plane
# reference. They do not grant the removed custom guest bindings to this runtime.
