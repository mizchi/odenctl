package myedge:runtime@0.1.0;

interface types {
  record header {
    name: string,
    value: string,
  }

  record request-head {
    method: string,
    uri: string,
    headers: list<header>,
  }

  record response-head {
    status: u16,
    headers: list<header>,
  }
}

interface http {
  use types.{request-head, response-head};

  resource incoming-body {
    read: async func(max: u64) -> option<list<u8>>;
  }

  resource outgoing-body {
    write: async func(chunk: list<u8>);
    finish: async func();
  }

  new-outgoing-body: func() -> outgoing-body;

  record request {
    head: request-head,
    body: incoming-body,
  }

  record response {
    head: response-head,
    body: outgoing-body,
  }
}

interface kv {
  resource namespace;

  open-namespace: func(binding: string) -> option<namespace>;
  get: async func(ns: borrow<namespace>, key: string) -> option<list<u8>>;
  put: async func(ns: borrow<namespace>, key: string, value: list<u8>, ttl-seconds: option<u64>);
  delete: async func(ns: borrow<namespace>, key: string);
}

interface secrets {
  resource secret;

  open-secret: func(binding: string) -> option<secret>;
  reveal: async func(s: borrow<secret>) -> string;
}

interface durable {
  resource object;

  open-object: func(binding: string, name: string) -> option<object>;
  get: async func(obj: borrow<object>, key: string) -> option<list<u8>>;
  put: async func(obj: borrow<object>, key: string, value: list<u8>);
  delete: async func(obj: borrow<object>, key: string) -> bool;
}

interface outbound {
  use types.{header};

  record request {
    method: string,
    uri: string,
    headers: list<header>,
    body: list<u8>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  fetch: async func(req: request) -> response;
}

interface service {
  use outbound.{request, response};

  fetch: async func(binding: string, req: request) -> response;
}

interface log {
  info: func(message: string);
  warn: func(message: string);
  error: func(message: string);
}

world worker {
  use http.{request, response};

  import http;
  import kv;
  import secrets;
  import durable;
  import outbound;
  import service;
  import log;

  export handle: async func(req: request) -> response;
}
