  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "coverage": "node --experimental-strip-types --test --experimental-test-coverage tests/*.test.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "runtime": "node --experimental-strip-types src/runtime/main.ts",
    "wasmplane": "node --experimental-strip-types src/cli.ts",
    "cost": "node --experimental-strip-types src/cost-estimator.ts",
    "bench": "node --experimental-strip-types src/bench.ts",
    "volume-sqlite-bench": "node --experimental-strip-types src/volume-sqlite-bench.ts",
    "cluster-bench": "node --experimental-strip-types src/cluster-bench.ts",
    "rust-daemon-bench": "node --experimental-strip-types src/rust-daemon-bench.ts",
    "ops-smoke": "node --experimental-strip-types src/ops-smoke.ts",
    "alarm-demo-smoke": "node --experimental-strip-types src/alarm-demo-smoke.ts",
    "cloudflare-control-smoke": "node --experimental-strip-types src/cloudflare-control-smoke.ts",
    "fly-scale-eval": "node --experimental-strip-types src/fly-scale-eval.ts",
    "fly-otel-evidence": "node --experimental-strip-types src/fly-otel-evidence.ts",
